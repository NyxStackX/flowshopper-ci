{
  "name": "flowshopper-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors magenta,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
