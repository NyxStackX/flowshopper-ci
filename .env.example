# Site
SITE_PORT=3000
BACKOFFICE_PORT=3001
DATABASE_URL=sqlite:./data/flowshopper.db
# Port of the React dev server (npm run dev); it forwards /api to SITE_PORT
CLIENT_DEV_PORT=5173
# Catalog CSV read by the web server, relative to the repository root
CATALOG_PATH=reco/data/flowshopper_catalog.csv

# Recommendation service
RECO_API_URL=http://localhost:8000
RECO_TIMEOUT_MS=800

# Stripe (test keys only)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
